{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "S3FullAccess",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject",
				"s3:ListBucket",
				"s3:DeleteObject"
			],
			"Resource": [
				"arn:aws:s3:::breta-open-lakehouse-agriculture-bronze/*",
				"arn:aws:s3:::breta-open-lakehouse-agriculture-bronze ",
				"arn:aws:s3:::breta-open-lakehouse-agriculture-silver/*",
				"arn:aws:s3:::breta-open-lakehouse-agriculture-silver",
				"arn:aws:s3:::breta-open-lakehouse-agriculture-gold/*",
				"arn:aws:s3:::breta-open-lakehouse-agriculture-gold",
				"arn:aws:s3:::breta-open-lakehouse-agriculture-scripts/*",
				"arn:aws:s3:::breta-open-lakehouse-agriculture-scripts"
			]
		},
		{
			"Effect": "Allow",
            "Action": [
                "glue:CreateTable",
                "glue:UpdateTable",
                "glue:DeleteTable",
                "glue:GetTable",
                "glue:CreatePartition",
                "glue:UpdatePartition",
                "glue:GetPartitions"
            ],
            "Resource": "*"
		},
		{
			"Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:*:*:*"
		}
	]
}